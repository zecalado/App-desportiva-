  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
